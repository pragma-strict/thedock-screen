# OfficeRnD OAuth2 client credentials
# Found in the OfficeRnD integrations/API settings
OFFICERND_CLIENT_ID=
OFFICERND_CLIENT_SECRET=

# OAuth2 scope for the OfficeRnD v2 API token request
# Defaults to the read scopes needed by this app (bookings, resources, floors, members, companies, plans).
# If set, it must include all of them — without flex.billing.plans.read the coffee/owl indicators are silently skipped.
# OFFICERND_SCOPE=flex.space.bookings.read flex.space.resources.read flex.space.floors.read flex.community.members.read flex.community.companies.read flex.billing.plans.read
